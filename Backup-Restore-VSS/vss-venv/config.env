# ----------------------------------------------------------------------------
# Pure-VSS Backup & Restore — environment template
#
# Copy this whole directory to ".venv" (sibling of this one) and edit the
# values below for your own lab. ".venv" is gitignored so real credentials
# never land in the repository:
#
#     cp -r vss-venv  .venv
#     $EDITOR .venv/config.env
#
# Every Python script in this folder reads .venv/config.env via
# winrm_helper.load_config(); the orchestrator refuses to run if the file is
# missing or any required key is blank.
# ----------------------------------------------------------------------------

# --- Source SQL Server VM (runs VssBackup.exe) -------------------------------
AGHOST_NAME=AgHost-1A
AGHOST_IP=192.168.0.10
AGHOST_USER=Administrator
AGHOST_PWD=ChangeMe_StrongP@ssw0rd

# --- Target SQL Server VM (runs VssRestore.exe) ------------------------------
SQLPOC_NAME=SqlPoc
SQLPOC_IP=192.168.0.11
SQLPOC_USER=Administrator
SQLPOC_PWD=ChangeMe_StrongP@ssw0rd

# --- SQL Server sa password (used by orchestrator sqlcmd helpers) ------------
# In this lab both VMs share the same sa password; change if yours differ.
SA_PWD=ChangeMe_StrongP@ssw0rd

# --- Samba transport share on the hypervisor ---------------------------------
# UNC path as seen from the Windows VMs.
SHARE_UNC=\\192.168.0.1\vss-transport
# Matching Linux path on the hypervisor for clean-up / listing.
SHARE_LINUX_PATH=/srv/samba/vss-transport

# --- Hypervisor host (Linux, running libvirt + Samba) ------------------------
HV_NAME=ryzen9
HV_IP=192.168.0.1

# =============================================================================
# Web GUI Authentication
# =============================================================================

# --- Enable / disable login gate (true = require login, false = open access) --
# Default is true (authentication enforced). Set to false for trusted LAN-only.
VSS_AUTH_ENABLED=true

# --- Session secret (leave blank = auto-generated once in .venv/auth_secret.key)
VSS_SECRET_KEY=

# =============================================================================
# SMTP — for password-reset emails (optional; leave blank to disable)
# If /etc/grafana/grafana.ini is readable, values are inherited automatically.
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PWD=
SMTP_FROM_ADDR=noreply@example.com
SMTP_FROM_NAME=VSS Console
SMTP_STARTTLS=true

# =============================================================================
# Google OAuth 2.0 (optional — leave blank to hide the Google button)
# Redirect URI to register in Google Cloud Console:
#   http://<your-host>:8765/auth/callback/google
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# GitHub OAuth (optional — leave blank to hide the GitHub button)
# Authorization callback URL to register in GitHub OAuth App:
#   http://<your-host>:8765/auth/callback/github
# =============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
