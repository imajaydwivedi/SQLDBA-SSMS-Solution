<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VssRestore</AssemblyName>
    <RootNamespace>VssRequester.Restore</RootNamespace>
    <!-- Always produce a self-contained win-x64 bundle.
         No .NET runtime installation required on the target SQL Server VM. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ArxOne.AlphaVSS" Version="2.2.1" />
    <PackageReference Include="ArxOne.AlphaVSS.Native.NetCore" Version="2.2.1" />
  </ItemGroup>

</Project>
